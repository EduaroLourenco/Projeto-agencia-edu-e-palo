# Precisa de um Postgres (o back-end roda como função serverless no Vercel,
# sem disco persistente, então SQLite não serve mais). Use o mesmo banco
# gratuito para desenvolver local e para produção — mais simples:
#   - Vercel Postgres / Neon: vercel.com → seu projeto → Storage → Create Database
#   - ou Supabase: supabase.com → New Project (copie a "Connection string" no modo "URI")
DATABASE_URL="postgresql://usuario:senha@host:5432/banco"

# Gere um valor forte e aleatório em produção (ex: `openssl rand -hex 32`).
JWT_SECRET="zap-commerce-dev-secret-troque-em-producao"

PORT=3001
