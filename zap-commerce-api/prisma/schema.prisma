// Postgres (Neon, via integração Vercel) — necessário porque o back-end roda
// como função serverless no Vercel, sem disco persistente.
//
// DATABASE_URL = conexão pooled (pgbouncer) — usada em runtime pelas funções.
// DIRECT_URL   = conexão direta, sem pooling — usada só por `prisma db push`
//                e migrations, que não funcionam bem atrás de um pooler.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Loja {
  id                 String   @id @default(cuid())
  slug               String   @unique
  nomeLoja           String
  aberto             Boolean  @default(true)
  whatsappNumero     String
  mensagemSaudacao   String   @default("Oi! Recebi seu pedido, já te confirmo o estoque 💕")
  senhaHash          String
  regraAtacadoTipo   String   @default("quantidade")
  regraAtacadoMinimo Float    @default(6)
  corDestaque        String   @default("#f22e69")
  criadoEm           DateTime @default(now())

  pontosRetirada PontoRetirada[]
  produtos       Produto[]
}

model PontoRetirada {
  id        String  @id @default(cuid())
  lojaId    String
  loja      Loja    @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  tipo      String
  nome      String
  descricao String?
}

model Produto {
  id                String   @id @default(cuid())
  lojaId            String
  loja              Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  nome              String
  precoVarejo       Float
  precoAtacado      Float
  categoriasJson    String
  tamanhosJson      String
  imageUrl          String
  instagramReelsUrl String?
  isUltimasPecas    Boolean  @default(false)
  isAtivo           Boolean  @default(true)
  criadoEm          DateTime @default(now())
}
