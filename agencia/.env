# Valor de desenvolvimento local. Em produção (Vercel), defina VITE_ZAP_COMMERCE_URL
# nas variáveis de ambiente do projeto, apontando para o domínio publicado do
# Zap-Commerce — sem isso, o botão "Ver o case funcionando" leva pro seu localhost.
VITE_ZAP_COMMERCE_URL=http://localhost:5173/bella-atacado

# Opcional: ID do Google Analytics (GA4). Deixe vazio para não carregar nada.
VITE_GA_MEASUREMENT_ID=
