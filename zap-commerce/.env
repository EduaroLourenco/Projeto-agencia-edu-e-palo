# Valor de desenvolvimento local. Em produção (Vercel), defina VITE_API_URL
# nas variáveis de ambiente do projeto apontando para a URL do back-end publicado
# (Render/Fly.io) — sem isso, o site publicado tenta falar com o seu localhost.
VITE_API_URL=http://localhost:3001

# Opcional: ID do Google Analytics (GA4). Deixe vazio para não carregar nada.
VITE_GA_MEASUREMENT_ID=
