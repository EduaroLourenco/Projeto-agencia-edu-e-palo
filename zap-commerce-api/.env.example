# Postgres via Neon (criado pela integração do Vercel). Duas URLs:
#   - DATABASE_URL → conexão pooled, usada em runtime
#   - DIRECT_URL   → conexão direta, usada só por `prisma db push`/migrations
# Copie ambas da tela do banco no Vercel (Storage → seu banco → .env.local → "Show secret").
DATABASE_URL="postgresql://usuario:senha@host-pooler.regiao.aws.neon.tech/banco?sslmode=require"
DIRECT_URL="postgresql://usuario:senha@host.regiao.aws.neon.tech/banco?sslmode=require"

# Gere um valor forte e aleatório em produção (ex: `openssl rand -hex 32`).
JWT_SECRET="zap-commerce-dev-secret-troque-em-producao"

PORT=3001
